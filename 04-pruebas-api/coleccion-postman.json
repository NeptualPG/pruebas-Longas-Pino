{
  "info": {
    "name": "Jeanstyle-PruebasAPI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login",
      "item": [
        {
          "name": "Login exitoso",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/{{endpoint_login}}",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{usuario_valido}}\",\n  \"password\": \"{{clave_valida}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status esperado login exitoso', function () { pm.response.to.have.status(Number(pm.environment.get('status_login_ok'))); });",
            "pm.test('Respuesta no vacia', function () { pm.expect(pm.response.text()).to.not.be.empty; });",
            "pm.test('Contiene token, sesion o 2FA', function () { const responseText = pm.response.text().toLowerCase(); pm.expect(responseText).to.match(/2fa|token|sesion|session|exito|código/); });"
          ] } }]
        },
        {
          "name": "Login fallido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/{{endpoint_login}}",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{usuario_valido}}\",\n  \"password\": \"{{clave_invalida}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status login fallido', function () { pm.response.to.have.status(Number(pm.environment.get('status_login_fail'))); });",
            "pm.test('Mensaje de error presente', function () { pm.expect(pm.response.text().toLowerCase()).to.match(/error|inválida|incorrect|fall|denied/); });"
          ] } }]
        },
        {
          "name": "Login sin datos",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/{{endpoint_login}}",
            "body": { "mode": "raw", "raw": "{}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status login sin datos', function () { pm.response.to.have.status(Number(pm.environment.get('status_login_bad_request'))); });"
          ] } }]
        }
      ]
    },
    {
      "name": "Maestro (Productos)",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": "{{base_url}}/{{endpoint_maestro_list}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status listar maestro', function () { pm.response.to.have.status(200); });",
            "pm.test('Lista no vacia o paginada', function () { const r = pm.response.json(); pm.expect(Array.isArray(r) || r.data || r.items).to.not.be.undefined; });"
          ] } }]
        },
        {
          "name": "Crear producto valido",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/{{endpoint_maestro_create}}",
            "body": { "mode": "raw", "raw": "{\n  \"id_prenda\": 1,\n  \"descripcion\": \"{{nombre_valido}}\",\n  \"id_estado\": 1\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status crear producto', function () { pm.response.to.have.status(Number(pm.environment.get('status_maestro_create_ok'))); });",
            "pm.test('Respuesta contiene ID generado', function () { const r = pm.response.json(); pm.expect(r).to.have.any.keys('id', 'id_producto', 'success'); });"
          ] } }]
        },
        {
          "name": "Crear producto invalido",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/{{endpoint_maestro_create}}",
            "body": { "mode": "raw", "raw": "{\n  \"id_prenda\": \"\",\n  \"descripcion\": \"\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status crear invalido', function () { pm.response.to.have.status(Number(pm.environment.get('status_maestro_bad_request'))); });"
          ] } }]
        },
        {
          "name": "Editar producto",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/{{endpoint_maestro_update}}/{{id_maestro}}",
            "body": { "mode": "raw", "raw": "{\n  \"descripcion\": \"{{nombre_editado}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status editar producto', function () { pm.response.to.have.status(200); });"
          ] } }]
        },
        {
          "name": "Eliminar producto",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": "{{base_url}}/{{endpoint_maestro_delete}}/{{id_maestro}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status eliminar producto', function () { pm.expect([200,204]).to.include(pm.response.code); });"
          ] } }]
        }
      ]
    },
    {
      "name": "Transaccional (Orders/Pedidos)",
      "item": [
        {
          "name": "Registrar pedido valido",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/{{endpoint_transaccional_create}}",
            "body": { "mode": "raw", "raw": "{\n  \"producto\": {{id_maestra}},\n  \"descripcion\": \"Pedido de prueba automatizado\",\n  \"estado\": 1\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status transaccion valida', function () { pm.response.to.have.status(Number(pm.environment.get('status_trans_ok'))); });",
            "pm.test('Contiene confirmacion (ID o Estado)', function () { const r = pm.response.json(); pm.expect(r).to.have.any.keys('id', 'estado', 'success', 'message'); });"
          ] } }]
        },
        {
          "name": "Registrar pedido invalido",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/{{endpoint_transaccional_create}}",
            "body": { "mode": "raw", "raw": "{\n  \"producto\": null,\n  \"descripcion\": \"\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status transaccion invalida', function () { pm.response.to.have.status(Number(pm.environment.get('status_trans_bad_request'))); });"
          ] } }]
        }
      ]
    }
  ]
}